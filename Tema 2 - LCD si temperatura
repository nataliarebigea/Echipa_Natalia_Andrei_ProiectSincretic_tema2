#include <LiquidCrystal.h>
#include <avr/io.h>
#include <avr/interrupt.h>

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

volatile uint8_t ore = 18;
volatile uint8_t minute = 1;
volatile uint8_t secunde = 55;

volatile bool actualizeaza_afisaj = false;

void ADC_Init() {
    ADMUX = (1 << REFS0);
    ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);
}

uint16_t ADC_Read() {
    ADCSRA |= (1 << ADSC);
    while (ADCSRA & (1 << ADSC));
    return ADC;
}

void Timer1_Init() {
    cli();

    TCCR1A = 0;
    TCCR1B = 0;
    TCNT1  = 0;

    OCR1A = 15624;

    TCCR1B |= (1 << WGM12) | (1 << CS12) | (1 << CS10);
    TIMSK1 |= (1 << OCIE1A);

    sei();
}

ISR(TIMER1_COMPA_vect) {
    secunde++;
    if (secunde >= 60) {
        secunde = 0;
        minute++;
        if (minute >= 60) {
            minute = 0;
            ore++;
            if (ore >= 24) {
                ore = 0;
            }
        }
    }
    actualizeaza_afisaj = true;
}

void setup() {
    Serial.begin(9600);
    lcd.begin(16, 2);

    ADC_Init();
    Timer1_Init();

    actualizeaza_afisaj = true;
}

void loop() {
    if (actualizeaza_afisaj) {
        actualizeaza_afisaj = false;

        uint16_t adc_val = ADC_Read();
        float tensiune_v = (adc_val * 5.0) / 1024.0;
        float temperatura = (tensiune_v - 0.5) * 100.0;

        char buffer_temp[17];
        snprintf(buffer_temp, sizeof(buffer_temp), "Temp = %d\xDF" "C", (int)temperatura);

        char buffer_ceas[17];
        snprintf(buffer_ceas, sizeof(buffer_ceas), "Ora %02d:%02d:%02d", ore, minute, secunde);

        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print(buffer_temp);

        lcd.setCursor(0, 1);
        lcd.print(buffer_ceas);

        Serial.print(buffer_temp);
        Serial.print(" | ");
        Serial.println(buffer_ceas);
    }
}
